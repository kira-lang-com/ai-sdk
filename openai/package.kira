//! The OpenAI wire protocol: canonical requests in, canonical responses out,
//! the chat-completions shape in between. `AIOpenRouter` builds on it.
/// The OpenAI protocol package: a backend that speaks the OpenAI chat-completions API and its compatible services.
construct AIOpenAI extends Package {
    let version: String = "26.10.4"
    let kind: PackageKind = .Library
    let moduleRoot: String = "AIOpenAI"
    let dependencies: [Dependency] = [
        Dependency { name: "AI", path: "../core" }
    ]
}
