//! The poolside model names, mapped to the SDK's canonical model constants.
import Foundation

/// The free endpoint `poolside/laguna-s-2.1:free`, reached through OpenRouter, as a remote model identity.
let LagunaS21Free: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "poolside/laguna-s-2.1:free"
}

/// The free endpoint `poolside/laguna-xs-2.1:free`, reached through OpenRouter, as a remote model identity.
let LagunaXS21Free: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "poolside/laguna-xs-2.1:free"
}
