//! The thinkingmachines model names, mapped to the SDK's canonical model constants.
import Foundation

/// The free endpoint `thinkingmachines/inkling-small:free`, reached through OpenRouter, as a remote model identity.
let InklingSmallFree: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "thinkingmachines/inkling-small:free"
}

/// The free endpoint `thinkingmachines/inkling:free`, reached through OpenRouter, as a remote model identity.
let InklingFree: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "thinkingmachines/inkling:free"
}
