import Foundation

// Tencent: Hy4 preview (tencent/hy4-preview)
let Hy4Preview: Model = Model {
    identity: ModelIdentity {
        provider: .Tencent,
        family: .Hunyuan,
        variant: .None,
        version: "4"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "tencent/hy4-preview"
        }
    ]
}
