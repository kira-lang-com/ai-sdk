import Foundation

// Tencent: Hy3 (tencent/hy3)
let Hy3: Model = Model {
    identity: ModelIdentity {
        provider: .Tencent,
        family: .Hunyuan,
        variant: .None,
        version: "3"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "tencent/hy3"
        }
    ]
}

// Tencent: Hy3 preview (tencent/hy3-preview)
let Hy3Preview: Model = Model {
    identity: ModelIdentity {
        provider: .Tencent,
        family: .Hunyuan,
        variant: .None,
        version: "3"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "tencent/hy3-preview"
        }
    ]
}
