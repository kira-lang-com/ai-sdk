//! The nvidia model names, mapped to the SDK's canonical model constants.
import Foundation

/// The free endpoint `nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free`, reached through OpenRouter, as a remote model identity.
let Nemotron3NanoOmni30bA3bReasoningFree: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
}

