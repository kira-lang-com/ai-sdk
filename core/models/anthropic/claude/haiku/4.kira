import Foundation

// Anthropic: Claude Haiku 4.5 (anthropic/claude-haiku-4.5)
let ClaudeHaiku45: Model = Model {
    identity: ModelIdentity {
        provider: .Anthropic,
        family: .Claude,
        variant: .Some(.Haiku),
        version: "4.5"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "anthropic/claude-haiku-4.5"
        }
    ]
}
