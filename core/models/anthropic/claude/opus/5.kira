import Foundation

// Claude Opus 5 (anthropic/claude-opus-5)
let ClaudeOpus5: Model = Model {
    identity: ModelIdentity {
        provider: .Anthropic,
        family: .Claude,
        variant: .Some(.Opus),
        version: "5"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "anthropic/claude-opus-5"
        }
    ]
}
