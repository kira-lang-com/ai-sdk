import Foundation

// Anthropic: Claude Sonnet 4 (anthropic/claude-sonnet-4)
let ClaudeSonnet4: Model = Model {
    identity: ModelIdentity {
        provider: .Anthropic,
        family: .Claude,
        variant: .Some(.Sonnet),
        version: "4"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "anthropic/claude-sonnet-4"
        }
    ]
}

