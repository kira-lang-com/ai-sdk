import Foundation

// Anthropic: Claude Sonnet 5 (anthropic/claude-sonnet-5)
let ClaudeSonnet5: Model = Model {
    identity: ModelIdentity {
        provider: .Anthropic,
        family: .Claude,
        variant: .Some(.Sonnet),
        version: "5"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "anthropic/claude-sonnet-5"
        }
    ]
}
