import Foundation

// MiniMax: MiniMax M2 (minimax/minimax-m2)
let MiniMaxM2: Model = Model {
    identity: ModelIdentity {
        provider: .MiniMax,
        family: .MiniMax,
        variant: .None,
        version: "m2"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "minimax/minimax-m2"
        }
    ]
}

