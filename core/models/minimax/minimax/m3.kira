import Foundation

// MiniMax: MiniMax M3 (minimax/minimax-m3)
let MiniMaxM3: Model = Model {
    identity: ModelIdentity {
        provider: .MiniMax,
        family: .MiniMax,
        variant: .None,
        version: "m3"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Video],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "minimax/minimax-m3"
        }
    ]
}
