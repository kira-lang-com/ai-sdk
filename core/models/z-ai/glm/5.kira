import Foundation

// Z.ai: GLM 5 (z-ai/glm-5)
let GLM5: Model = Model {
    identity: ModelIdentity {
        provider: .ZAI,
        family: .GLM,
        variant: .None,
        version: "5"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "z-ai/glm-5"
        }
    ]
}

