import Foundation

// Z.ai: GLM 4.5 (z-ai/glm-4.5)
let GLM45: Model = Model {
    identity: ModelIdentity {
        provider: .ZAI,
        family: .GLM,
        variant: .None,
        version: "4.5"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "z-ai/glm-4.5"
        }
    ]
}

