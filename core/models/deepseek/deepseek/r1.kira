import Foundation

// DeepSeek: R1 (deepseek/deepseek-r1)
let DeepSeekR1: Model = Model {
    identity: ModelIdentity {
        provider: .DeepSeek,
        family: .DeepSeek,
        variant: .None,
        version: "r1"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "deepseek/deepseek-r1"
        }
    ]
}

