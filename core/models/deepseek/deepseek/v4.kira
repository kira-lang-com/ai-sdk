import Foundation

// DeepSeek: DeepSeek V4.1 Flash (deepseek/deepseek-v4.1-flash)
let DeepSeekV41Flash: Model = Model {
    identity: ModelIdentity {
        provider: .DeepSeek,
        family: .DeepSeek,
        variant: .None,
        version: "v4.1"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "deepseek/deepseek-v4.1-flash"
        }
    ]
}

