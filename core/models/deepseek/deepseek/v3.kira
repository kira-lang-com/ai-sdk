import Foundation

// DeepSeek: DeepSeek V3 (deepseek/deepseek-chat)
let DeepSeekChat: Model = Model {
    identity: ModelIdentity {
        provider: .DeepSeek,
        family: .DeepSeek,
        variant: .None,
        version: "v3"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: false,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "deepseek/deepseek-chat"
        }
    ]
}

