import Foundation

// ByteDance Seed: Seed 1.6 (bytedance-seed/seed-1.6)
let Seed16: Model = Model {
    identity: ModelIdentity {
        provider: .ByteDance,
        family: .Seed,
        variant: .None,
        version: "1.6"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Video],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "bytedance-seed/seed-1.6"
        }
    ]
}

