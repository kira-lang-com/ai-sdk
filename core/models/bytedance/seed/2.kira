import Foundation

// ByteDance Seed: Seed-2.0-Code (bytedance-seed/seed-2.0-code)
let Seed20Code: Model = Model {
    identity: ModelIdentity {
        provider: .ByteDance,
        family: .Seed,
        variant: .None,
        version: "2.0"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Video],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "bytedance-seed/seed-2.0-code"
        }
    ]
}

