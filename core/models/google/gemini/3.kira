import Foundation

// Google: Gemini 3 Flash Preview (google/gemini-3-flash-preview)
let Gemini3FlashPreview: Model = Model {
    identity: ModelIdentity {
        provider: .Google,
        family: .Gemini,
        variant: .None,
        version: "3"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Audio, .Video, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "google/gemini-3-flash-preview"
        }
    ]
}

