import Foundation

// Google: Gemini 2.5 Flash (google/gemini-2.5-flash)
let Gemini25Flash: Model = Model {
    identity: ModelIdentity {
        provider: .Google,
        family: .Gemini,
        variant: .None,
        version: "2.5"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Audio, .Video, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "google/gemini-2.5-flash"
        }
    ]
}

