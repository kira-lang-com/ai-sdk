import Foundation

// OpenAI: GPT-4 Turbo (openai/gpt-4-turbo)
let Gpt4Turbo: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .GPT,
        variant: .None,
        version: "4"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: false,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/gpt-4-turbo"
        }
    ]
}

