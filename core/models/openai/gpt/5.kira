import Foundation

// OpenAI: GPT-5 Pro (openai/gpt-5-pro)
let Gpt5Pro: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .GPT,
        variant: .None,
        version: "5"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/gpt-5-pro"
        }
    ]
}

