import Foundation

// OpenAI: gpt-oss-safeguard-20b (openai/gpt-oss-safeguard-20b)
let GptOssSafeguard20b: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .GPT,
        variant: .None,
        version: "oss"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/gpt-oss-safeguard-20b"
        }
    ]
}

