import Foundation

// OpenAI: GPT-4o (2024-11-20) (openai/gpt-4o-2024-11-20)
let Gpt4o20241120: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .GPT,
        variant: .None,
        version: "4o"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: false,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/gpt-4o-2024-11-20"
        }
    ]
}

