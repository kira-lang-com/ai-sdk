import Foundation

// OpenAI: GPT-3.5 Turbo (older v0613) (openai/gpt-3.5-turbo-0613)
let Gpt35Turbo0613: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .GPT,
        variant: .None,
        version: "3.5"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: false,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/gpt-3.5-turbo-0613"
        }
    ]
}

