import Foundation

// OpenAI: o4 Mini High (openai/o4-mini-high)
let O4MiniHigh: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .O,
        variant: .None,
        version: "4"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/o4-mini-high"
        }
    ]
}

