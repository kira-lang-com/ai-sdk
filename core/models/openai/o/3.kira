import Foundation

// OpenAI: o3 Pro (openai/o3-pro)
let O3Pro: Model = Model {
    identity: ModelIdentity {
        provider: .OpenAI,
        family: .O,
        variant: .None,
        version: "3"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .File],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "openai/o3-pro"
        }
    ]
}

