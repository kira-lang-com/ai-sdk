import Foundation

// StepFun: Step 3.5 Flash (stepfun/step-3.5-flash)
let Step35Flash: Model = Model {
    identity: ModelIdentity {
        provider: .StepFun,
        family: .Step,
        variant: .None,
        version: "3.5"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: true,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "stepfun/step-3.5-flash"
        }
    ]
}

