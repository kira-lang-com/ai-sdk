import Foundation

// MoonshotAI: Kimi K2 0711 (moonshotai/kimi-k2)
let KimiK2: Model = Model {
    identity: ModelIdentity {
        provider: .MoonshotAI,
        family: .Kimi,
        variant: .None,
        version: "k2"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: false,
        promptCaching: false
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "moonshotai/kimi-k2"
        }
    ]
}

