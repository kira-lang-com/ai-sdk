import Foundation

// MoonshotAI: Kimi K3 (moonshotai/kimi-k3)
let KimiK3: Model = Model {
    identity: ModelIdentity {
        provider: .MoonshotAI,
        family: .Kimi,
        variant: .None,
        version: "k3"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Video],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "moonshotai/kimi-k3"
        }
    ]
}
