import Foundation

let Ling30FlashFinFree: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "inclusionai/ling-3.0-flash-fin:free"
}

// inclusionAI: Ling 3.0 Flash (inclusionai/ling-3.0-flash)
let Ling30Flash: Model = Model {
    identity: ModelIdentity {
        provider: .InclusionAI,
        family: .Ling,
        variant: .None,
        version: "3.0"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "inclusionai/ling-3.0-flash"
        }
    ]
}

// inclusionAI: Ling 3.0 Flash Fin (inclusionai/ling-3.0-flash-fin)
let Ling30FlashFin: Model = Model {
    identity: ModelIdentity {
        provider: .InclusionAI,
        family: .Ling,
        variant: .None,
        version: "3.0"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "inclusionai/ling-3.0-flash-fin"
        },
        Ling30FlashFinFree
    ]
}

let Ling30FlashSanteFree: RemoteModelID = RemoteModelID {
