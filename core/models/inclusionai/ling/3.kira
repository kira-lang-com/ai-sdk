//! inclusionAI: Ling 3.0 Flash (inclusionai/ling-3.0-flash)
//!
//! The model's constant, with its identity, capabilities and endpoint, as the SDK catalogue declares it.
import Foundation

/// The free endpoint `inclusionai/ling-3.0-flash-fin:free`, reached through OpenRouter, as a remote model identity.
let Ling30FlashFinFree: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "inclusionai/ling-3.0-flash-fin:free"
}

/// inclusionAI: Ling 3.0 Flash (inclusionai/ling-3.0-flash)
let Ling30Flash: Model = Model {
    identity: ModelIdentity {
        provider: .InclusionAI,
        family: .Ling,
        variant: .None,
        version: "3.0"
    },
    capabilities: ModelCapabilities {
        input: [.Text],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: false,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter,
            protocol: .OpenAI,
            region: .Some(.Global),
            id: "inclusionai/ling-3.0-flash"
        }
    ]
}

