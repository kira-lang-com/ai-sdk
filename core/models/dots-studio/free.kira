//! The dots-studio model names, mapped to the SDK's canonical model constants.
import Foundation

/// The free endpoint `dots-studio/dots-3-note-preview:free`, reached through OpenRouter, as a remote model identity.
let Dots3NotePreviewFree: RemoteModelID = RemoteModelID {
    service: .OpenRouter,
    protocol: .OpenAI,
    region: .Some(.Global),
    id: "dots-studio/dots-3-note-preview:free"
}
