import Foundation

// Xiaomi: MiMo-V2.5 (xiaomi/mimo-v2.5)
let MiMoV25: Model = Model {
    identity: ModelIdentity {
        provider: .Xiaomi,
        family: .MiMo,
        variant: .None,
        version: "2.5"
    },
    capabilities: ModelCapabilities {
        input: [.Text, .Image, .Audio, .Video],
        output: [.Text],
        streaming: true,
        toolCalling: true,
        structuredOutput: true,
        reasoning: true,
        promptCaching: true
    },
    remoteIDs: [
        RemoteModelID {
            service: .OpenRouter, protocol: .OpenAI,
            region: .Some(.Global), id: "xiaomi/mimo-v2.5"
        }
    ]
}

