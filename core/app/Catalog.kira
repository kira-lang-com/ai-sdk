// The models the SDK ships knowing, each as one canonical identity with every
// endpoint it can be reached at.
//
// A model is a namespace member — `AI.Providers.OpenAI.GPT.5.6.Sol` — so the
// path reads as what the model *is*: provider, family, version, variant. The
// version is a numeric path segment, which the language reads as one segment
// exactly as it reads `5.6` as one number. The separation the SDK is built on
// shows here plainly: `Sol` is an *OpenAI* model, and one of its endpoints is an
// Anthropic-shaped proxy — the model's provider and the service it happens to be
// served through are different facts, and the second never edits the first.

import Foundation

namespace AI.Providers.OpenAI.GPT.5.6 {
    // The full multimodal surface.
    let Sol = Model {
        identity: ModelIdentity {
            provider: .OpenAI,
            family: .GPT,
            variant: .Some(.Sol),
            version: "5.6"
        },
        capabilities: ModelCapabilities {
            input: [.Text, .Image, .Audio, .Video, .File],
            output: [.Text, .Image, .Audio],
            streaming: true,
            toolCalling: true,
            structuredOutput: true,
            reasoning: true,
            promptCaching: true
        },
        remoteIDs: [
            RemoteModelID {
                service: .OpenAI, protocol: .OpenAI,
                region: .Some(.Global), id: "gpt-5.6-sol"
            },
            RemoteModelID {
                service: .OpenRouter, protocol: .OpenAI,
                region: .Some(.Global), id: "openai/gpt-5.6-sol"
            },
            RemoteModelID {
                service: .AmazonBedrock, protocol: .Bedrock,
                region: .Some(.US), id: "openai.gpt-5.6-sol-v1:0"
            },
            RemoteModelID {
                service: .AmazonBedrock, protocol: .Bedrock,
                region: .Some(.USWest1), id: "us-west-1.openai.gpt-5.6-sol-v1:0"
            },
            RemoteModelID {
                service: .Azure, protocol: .AzureOpenAI,
                region: .Some(.US), id: "gpt-56-sol"
            },
            // Still an OpenAI model; it just happens to be served through an
            // Anthropic-style proxy.
            RemoteModelID {
                service: .Anthropic, protocol: .Anthropic,
                region: .Some(.Global), id: "proxy.openai.gpt-5.6-sol"
            }
        ]
    }

    // Text out, a smaller multimodal input.
    let Luna = Model {
        identity: ModelIdentity {
            provider: .OpenAI,
            family: .GPT,
            variant: .Some(.Luna),
            version: "5.6"
        },
        capabilities: ModelCapabilities {
            input: [.Text, .Image, .Audio],
            output: [.Text],
            streaming: true,
            toolCalling: true,
            structuredOutput: true,
            reasoning: true,
            promptCaching: true
        },
        remoteIDs: [
            RemoteModelID {
                service: .OpenAI, protocol: .OpenAI,
                region: .Some(.Global), id: "gpt-5.6-luna"
            },
            RemoteModelID {
                service: .OpenRouter, protocol: .OpenAI,
                region: .Some(.Global), id: "openai/gpt-5.6-luna"
            }
        ]
    }
}

