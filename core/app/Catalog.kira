namespace AI.Providers.Nvidia.Nemotron.3 {
    // NVIDIA's Nemotron 3 Super, free through OpenRouter — smaller than Ultra,
    // and so more often reachable when the largest free endpoints are saturated.
    let Super = Model {
        identity: ModelIdentity {
            provider: .Nvidia,
            family: .Nemotron,
            variant: .Some(.Small),
            version: "3-super"
