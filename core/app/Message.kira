//! The content a request carries in and a response carries out — typed all the
//! way down, so nothing above the wire ever holds a bag of untyped JSON.
//!
//! Input and output are separate enums because a model reads and writes different
//! things: you send it a video, it does not send you one back. Keeping them apart
//! makes an impossible message unspellable rather than merely unlikely.

import Foundation

/// A run of text, in or out.
public struct TextPart {
    let text: String
}

/// An image, carried inline as base64 with its media type.
///
/// `mediaType` travels with the bytes because a service needs it and cannot
/// always infer it, and a guess that is wrong is a decode error phrased as a
/// content error.
public struct ImagePart {
    let mediaType: String
    let base64: String
}

/// Audio, carried the same way.
public struct AudioPart {
    let mediaType: String
    let base64: String
}

/// Video, carried the same way.
public struct VideoPart {
    let mediaType: String
    let base64: String
}

/// A file handed to the model by name and bytes.
public struct FilePart {
    let name: String
    let mediaType: String
    let base64: String
}

/// The model's own reasoning, when it exposes it as content distinct from the
/// answer. Kept as its own part so a caller can show it, log it, or drop it
/// without parsing the answer to find where thinking ended.
///
/// `signature` is the service's seal over the reasoning. Anthropic refuses a
/// tool-use turn whose replayed thinking lost it, and other services that
/// return reasoning (Kimi, DeepSeek) expect it back on the next turn, so it is
/// carried rather than dropped.
public struct Reasoning {
    let text: String
    let signature: String? = .None
}

/// A JSON Schema, as the document a tool or a structured-output request is shaped
/// by. Held as a `JsonValue` — the parsed shape Foundation already speaks — so it
/// is composed and emitted without a round trip through text.
public struct Schema {
    let json: JsonValue
}

/// A tool a model may call: a name, a sentence telling the model when to reach
/// for it, and the schema its arguments must satisfy.
public struct Tool {
    let name: String
    let description: String
    let inputSchema: Schema
}

/// A model's request to call a tool. `input` is the arguments it chose, parsed,
/// as JSON because they are the tool's shape, not this SDK's. A protocol that
/// carries them as text (OpenAI's `arguments`) writes them back as text.
public struct ToolCall {
    let id: String
    let name: String
    let input: JsonValue
}

/// The result of running a tool, to be handed back on the next turn. `id` ties it
/// to the `ToolCall` it answers.
public struct ToolResult {
    let id: String
    let output: JsonValue
}

/// One piece of what a caller sends.
///
/// A request's input is a list of these, so text and an image go in one message
/// in the order they were written, and a model that reads both sees both.
public enum Input {
    Text(TextPart)
    Image(ImagePart)
    Audio(AudioPart)
    Video(VideoPart)
    File(FilePart)
}

/// One turn in a conversation, named by who produced it.
///
/// A request is no longer one thing said once: an agent sends the whole exchange
/// so far, because a model that called a tool has to see its own call and the
/// result before it can carry on. The three roles carry different things — a user
/// sends input parts, the assistant produced output parts (text and the tool
/// calls it chose), a tool turn carries the results those calls asked for — so
/// this is an enum over the role rather than a struct with a role field and a
/// content type that would have to be all three at once. An impossible turn, like
/// a tool result the assistant never asked for, is unspellable rather than merely
/// discouraged.
///
/// `Assistant` carries `[Output]` — the exact list a prior `Response` produced —
/// so replaying a turn is handing back what came out, not rebuilding it. A
/// backend encodes each role in its own wire shape; a caller never writes one.
public enum Message {
    User([Input])
    Assistant([Output])
    ToolResults([ToolResult])
}

/// The one-turn conversation a plain prompt is: a single user message carrying
/// these parts. The common request has no history, and this is how it says so
/// without spelling the enum at every call site.
public function userTurn(input: [Input]) -> [Message] {
    return [.User(move input)]
}

/// One piece of what a model returns.
///
/// `Object` is a structured-output answer — the JSON the model was asked to
/// produce — and `Call` is a tool invocation. A single response may carry several
/// of these: reasoning, then text, then a tool call.
public enum Output {
    Text(TextPart)
    Image(ImagePart)
    Audio(AudioPart)
    Object(JsonValue)
    Call(ToolCall)
    Reason(Reasoning)
}

/// Why generation stopped.
///
/// Separate from any error type because most of these are not errors: `Completed`
/// is the good case, and `ToolCall` means the model wants to act, not that it
/// failed. Only `Refusal` and `Error` are failures, and a caller does different
/// things about each of the six.
public enum FinishReason {
    Completed
    Length
    ToolCall
    Refusal
    Error
    Cancelled
}

/// A tool call as it begins: what the model is calling, before its arguments.
public struct ToolCallOpened {
    let id: String
    let name: String
}

/// A piece of a tool call's arguments as the model writes them. `json` is a
/// fragment of JSON text, not a value: it parses only once the call ends.
public struct ToolInputDelta {
    let id: String
    let json: String
}

/// One event in a stream.
///
/// A stream is not a stream of text: it is a stream of typed events, so a
/// consumer switches on what arrived rather than parsing a text channel for
/// structure that was thrown away. Text arrives as a `Start`/`Delta`/`End`
/// bracket so a consumer knows a run began and ended; reasoning and tool calls
/// have the same shape. A stream ends with exactly one of `Completed`, which
/// carries the assembled `Response`, or `Failed`.
public enum StreamEvent {
    TextStart
    TextDelta(TextPart)
    TextEnd

    ReasoningStart
    ReasoningDelta(Reasoning)
    ReasoningEnd

    ToolCallStart(ToolCallOpened)
    ToolCallDelta(ToolInputDelta)
    ToolCallEnd(ToolCall)

    UsageEvent(Usage)
    Completed(Response)
    Failed(AIError)
}

/// A finished response as the events that would have produced it, for a
/// service that answered a streaming request with one whole document.
public function eventsOf(response: Response) -> [StreamEvent] {
    var events: [StreamEvent] = []
    for output in response.output {
        match output {
            Text(body) -> events.appendAll([.TextStart, .TextDelta(copy body), .TextEnd])
            Reason(reasoning) -> events.appendAll(
                [.ReasoningStart, .ReasoningDelta(copy reasoning), .ReasoningEnd]
            )
            Call(call) -> {
                events.append(.ToolCallStart(ToolCallOpened { id: call.id, name: call.name }))
                events.append(.ToolCallEnd(copy call))
            }
            Image(_) -> {}
            Audio(_) -> {}
            Object(_) -> {}
        }
    }
    events.append(.UsageEvent(copy response.usage))
    events.append(.Completed(move response))
    return events
}
